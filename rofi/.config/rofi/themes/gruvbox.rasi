/* Gruvbox Dark theme - palette */
* {
    /* Gruvbox dark palette */
    bg:               rgba(40, 40, 40, 100%);
    bg-alt:           rgba(60, 56, 54, 100%);
    bg-hover:         rgba(102, 92, 84, 100%);
    fg:               rgba(235, 219, 178, 100%);
    fg-dim:           rgba(146, 131, 116, 100%);
    accent:           rgba(215, 153, 33, 100%);
    red:              rgba(251, 73, 52, 100%);
    green:            rgba(184, 187, 38, 100%);
    yellow:           rgba(215, 153, 33, 100%);
    blue:             rgba(131, 165, 152, 100%);
    magenta:          rgba(211, 134, 155, 100%);
    cyan:             rgba(142, 192, 124, 100%);
    orange:           rgba(254, 128, 25, 100%);
}

window {
    background-color: transparent;
    border-radius:    10px;
    border:           2px;
    border-color:     @orange;
    location:         center;
    anchor:           center;
    width:            40%;
    padding:          0.5em;
    margin:           0px;
    children:         [inputbar, listview];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          0.5em;
    spacing:          0.5em;
    children:         [prompt, entry];
}

prompt {
    text-color: @accent;
    font:        "JetBrainsMono Nerd Font SemiBold 13";
}

entry {
    text-color: @fg;
    font:       "JetBrainsMono Nerd Font SemiBold 13";
}

listview {
    background-color: @bg;
    border-radius:    6px;
    padding:          0.5em;
    spacing:          0.2em;
    layout:           vertical;
    columns:          1;
    lines:            8;
}

element {
    background-color: transparent;
    padding:          0.5em;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font SemiBold 11";
}

element selected {
    background-color: @bg-hover;
    border-radius:    6px;
    text-color:       @accent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

message {
    background-color: transparent;
    padding:          0.5em;
}

error-message {
    background-color: @bg;
    border-radius:    6px;
    padding:          0.5em;
    text-color:       @red;
}
